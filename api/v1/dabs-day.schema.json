{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelheiniger.github.io/easydabs/api/v1/dabs-day.schema.json",
  "title": "EasyDABS v1: one DABS day",
  "description": "A GeoJSON FeatureCollection of the areas in one Daily Airspace Bulletin Switzerland. See README.md next to this file.",
  "type": "object",
  "required": ["type", "properties", "features"],
  "additionalProperties": false,
  "properties": {
    "type": { "const": "FeatureCollection" },
    "properties": {
      "type": "object",
      "required": ["schema_version", "dabs_date", "version", "generated_utc"],
      "additionalProperties": false,
      "properties": {
        "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
        "dabs_date": { "$ref": "#/$defs/date" },
        "version": { "type": "integer", "minimum": 1 },
        "generated_utc": { "$ref": "#/$defs/utc" }
      }
    },
    "features": { "type": "array", "items": { "$ref": "#/$defs/area" } }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "utc": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$" },
    "position": {
      "description": "[longitude, latitude] in WGS 84 degrees, as GeoJSON orders them.",
      "type": "array",
      "prefixItems": [
        { "type": "number", "minimum": -180, "maximum": 180 },
        { "type": "number", "minimum": -90, "maximum": 90 }
      ],
      "minItems": 2,
      "maxItems": 2
    },
    "ring": { "type": "array", "items": { "$ref": "#/$defs/position" }, "minItems": 4 },
    "polygon": { "type": "array", "items": { "$ref": "#/$defs/ring" }, "minItems": 1 },
    "geometry": {
      "oneOf": [
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": { "type": { "const": "Polygon" }, "coordinates": { "$ref": "#/$defs/polygon" } }
        },
        {
          "type": "object",
          "required": ["type", "coordinates"],
          "additionalProperties": false,
          "properties": {
            "type": { "const": "MultiPolygon" },
            "coordinates": { "type": "array", "items": { "$ref": "#/$defs/polygon" }, "minItems": 1 }
          }
        }
      ]
    },
    "verticalLimit": {
      "oneOf": [
        {
          "type": "object",
          "required": ["kind", "raw"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "ground" }, "raw": { "type": "string" } }
        },
        {
          "type": "object",
          "required": ["kind", "raw", "flight_level"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "flight_level" },
            "raw": { "type": "string" },
            "flight_level": { "type": "integer", "minimum": 0 }
          }
        },
        {
          "type": "object",
          "required": ["kind", "raw", "meters", "feet"],
          "additionalProperties": false,
          "properties": {
            "kind": { "const": "altitude" },
            "raw": { "type": "string" },
            "meters": { "type": "integer" },
            "feet": { "type": "integer" }
          }
        },
        {
          "type": "object",
          "required": ["kind", "raw"],
          "additionalProperties": false,
          "properties": { "kind": { "const": "unknown" }, "raw": { "type": "string" } }
        }
      ]
    },
    "area": {
      "type": "object",
      "required": ["type", "geometry", "properties"],
      "additionalProperties": false,
      "properties": {
        "type": { "const": "Feature" },
        "geometry": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/geometry" }] },
        "properties": {
          "type": "object",
          "required": ["id", "notam", "on_chart", "validity", "lower", "upper", "shape", "center", "radius_m", "text"],
          "additionalProperties": false,
          "properties": {
            "id": { "type": "string", "minLength": 1 },
            "notam": { "type": ["string", "null"], "pattern": "^[A-Z][0-9]{4}/[0-9]{2}$" },
            "on_chart": { "type": "boolean" },
            "validity": {
              "type": "object",
              "required": ["from_utc", "to_utc", "from_start_of_day", "to_end_of_day"],
              "additionalProperties": false,
              "properties": {
                "from_utc": { "$ref": "#/$defs/utc" },
                "to_utc": { "$ref": "#/$defs/utc" },
                "from_start_of_day": { "type": "boolean" },
                "to_end_of_day": { "type": "boolean" }
              }
            },
            "lower": { "$ref": "#/$defs/verticalLimit" },
            "upper": { "$ref": "#/$defs/verticalLimit" },
            "shape": { "enum": ["polygon", "airspace", "circle", "unmapped"] },
            "center": {
              "type": "object",
              "required": ["lat", "lon"],
              "additionalProperties": false,
              "properties": {
                "lat": { "type": "number", "minimum": -90, "maximum": 90 },
                "lon": { "type": "number", "minimum": -180, "maximum": 180 }
              }
            },
            "radius_m": { "type": "integer", "minimum": 0 },
            "text": { "type": "string" }
          }
        }
      },
      "if": { "properties": { "properties": { "properties": { "shape": { "const": "unmapped" } } } } },
      "then": { "properties": { "geometry": { "type": "null" } } },
      "else": { "properties": { "geometry": { "type": "object" } } }
    }
  }
}
