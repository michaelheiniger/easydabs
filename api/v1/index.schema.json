{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://michaelheiniger.github.io/easydabs/api/v1/index.schema.json",
  "title": "EasyDABS v1: the DABS days published",
  "description": "The days from today (UTC, like the DABS day) onwards that have a published DABS. See README.md next to this file.",
  "type": "object",
  "required": ["schema_version", "days"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "type": "string", "pattern": "^1\\.[0-9]+$" },
    "days": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["dabs_date", "version", "generated_utc", "path"],
        "additionalProperties": false,
        "properties": {
          "dabs_date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
          "version": { "type": "integer", "minimum": 1 },
          "generated_utc": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}Z$"
          },
          "path": { "type": "string", "pattern": "^dabs-[0-9]{4}-[0-9]{2}-[0-9]{2}\\.json$" }
        }
      }
    }
  }
}
